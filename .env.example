# Copia este archivo como `.env.local` en la aplicación que conecte con Supabase.
# Nunca subas `.env.local` al repositorio.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica
# Esta clave solo debe vivir en el servidor, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-de-servidor
